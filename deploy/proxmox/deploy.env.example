# Copy to deploy.env (ignored by git) and fill in for your server.
# ssh host (alias from ~/.ssh/config) of the Proxmox node
HOST=proxmox
# id of the CT that runs Docker
CT=100
# service folder on the node, holding docker-compose.yml, oukile.env and data/
SRC=/mnt/pve/services/oukile
# the same folder inside the CT (its mount point)
DEST=/mnt/services/oukile
