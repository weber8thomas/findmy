# Copy to .env and adjust. Every setting has a sensible default.

# Public URL of the instance. Required behind HTTPS so cookies are marked Secure
# and the Origin check accepts your domain.
# BASE_URL=https://find.example.com
# Set when running behind Caddy / a reverse proxy.
# TRUST_PROXY=true
# Used by the `https` compose profile.
# SITE_ADDRESS=find.example.com

# Generated into /data/secret_key on first start if unset. Losing it means
# re-connecting Apple accounts (their secrets are encrypted with it).
# SECRET_KEY=

# Close sign-ups once your family accounts exist (the first account is admin).
ALLOW_REGISTRATION=true

# Keep location history this many days.
LOCATION_RETENTION_DAYS=30

# Map tiles. The OpenStreetMap tile servers have a fair-use policy: for heavy use,
# switch to another provider or self-host tiles.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=&copy; OpenStreetMap contributors

# Contact used in Web Push (VAPID) requests.
# VAPID_SUBJECT=mailto:you@example.com

# Geofences
# ZONE_CONFIRM_FIXES=2
# ZONE_MAX_ACCURACY_M=250

# Location sources
FEATURE_OWNTRACKS=true
# Unofficial Apple integrations - read docs/icloud.md and docs/findmy-network.md first.
FEATURE_ICLOUD=false
ICLOUD_POLL_INTERVAL_S=120
FEATURE_FINDMY=false
FINDMY_POLL_INTERVAL_S=300
# ANISETTE_URL=http://anisette:6969
