# Copy to .env and adjust. Every setting has a sensible default.

# Public URL of the instance. Required behind HTTPS so cookies are marked Secure
# and the Origin check accepts your domain.
# BASE_URL=https://find.example.com
# Set when running behind Caddy / a reverse proxy.
# TRUST_PROXY=true
# Used by the `https` compose profile.
# SITE_ADDRESS=find.example.com

# Generated into /data/secret_key on first start if unset. Losing it means
# re-connecting Apple accounts (their secrets are encrypted with it).
# SECRET_KEY=

# Close sign-ups once your family accounts exist (the first account is admin).
ALLOW_REGISTRATION=true

# Language of the sign-in page and of new accounts: en or fr (default: the browser's).
# Each person then picks theirs in Me > Settings > Language.
# DEFAULT_LOCALE=fr

# Single sign-on (OpenID Connect: Authentik, Keycloak, ...) - see docs/sso.md.
# OIDC_ISSUER=https://auth.example.com/application/o/oukile/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Authentik
# Create accounts on first SSO sign-in (defaults to ALLOW_REGISTRATION).
# OIDC_REGISTRATION=true
# Hide the email/password form: SSO only.
# PASSWORD_LOGIN=false

# Interactive API documentation at /api/docs (off: it maps the API for attackers too).
# API_DOCS=true

# Keep location history this many days.
LOCATION_RETENTION_DAYS=30

# Map. Default: OpenFreeMap's vector style (free, no key), drawn in night colours on a device in
# dark mode. TILE_URL takes
# either a MapLibre style URL or a raster tile URL, e.g. the plain OpenStreetMap style
# (fair-use policy applies):
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION=&copy; OpenStreetMap contributors
# A map of its own for dark mode. Unset: TILE_URL, in night colours when it is a vector style.
# TILE_URL_DARK=

# Address search when placing a zone (Me > Places & alerts). The server asks OpenStreetMap
# Nominatim for the user: only the typed text goes out, never their IP. It keeps to the
# Nominatim usage policy (one request per second at most, answers cached, no search as you
# type). Point it to your own Nominatim server, or leave it empty to turn address search off.
# GEOCODER_URL=https://nominatim.openstreetmap.org

# Contact used in Web Push (VAPID) requests.
# VAPID_SUBJECT=mailto:you@example.com

# Geofences
# ZONE_CONFIRM_FIXES=2
# ZONE_MAX_ACCURACY_M=250

# Location sources
FEATURE_OWNTRACKS=true
# Unofficial Apple integrations - read docs/icloud.md and docs/findmy-network.md first.
FEATURE_ICLOUD=false
ICLOUD_POLL_INTERVAL_S=120
FEATURE_FINDMY=false
FINDMY_POLL_INTERVAL_S=300
# ANISETTE_URL=http://anisette:6969
